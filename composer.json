{
    "name": "budimanlai/yii2-ocpp-sdk",
    "description": "Yii2 extension for OCPP (Open Charge Point Protocol) SDK - supports OCPP 1.6 and 2.0.1",
    "keywords": ["yii2", "ocpp", "ev", "charging", "electric vehicle"],
    "homepage": "https://github.com/budimanlai/yii-ocpp-sdk",
    "type": "yii2-extension",
    "version": "1.0.3",
    "license": "MIT",
    "authors": [
        {
            "name": "Budiman Lai",
            "email": "budiman.lai@gmail.com"
        }
    ],
    "repositories": [
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        }
    ],
    "require": {
        "php": ">=7.4",
        "yiisoft/yii2": "~2.0",
        "yiisoft/yii2-httpclient": "~2.0",
        "budimanlai/yii2-pkg": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0"
    },
    "autoload": {
        "psr-4": {
            "budimanlai\\ocpp\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "budimanlai\\ocpp\\tests\\": "tests/"
        }
    },
"minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "yiisoft/yii2-composer": true
        }
    }
}
